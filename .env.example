# Copy to .env for local development (`node --env-file=.env server/index.js`)
# or pass these to Docker with `-e` / the `environment:` section in docker-compose.yml.

# Port and address to listen on
PORT=8080
HOST=0.0.0.0

# Where the SQLite database is stored (default: ./data, /data in Docker)
DATA_DIR=./data
# DATABASE_PATH=./data/ledgerly.db

# Sign-ups. Unset = admins choose in Settings. "true"/"false" forces it.
# The very first account can always be created and becomes the administrator.
# ALLOW_REGISTRATION=false

# How long a sign-in lasts, in days (extended while you keep using the app)
SESSION_DAYS=30

# Set to true behind a reverse proxy so X-Forwarded-For / X-Forwarded-Proto are trusted
TRUST_PROXY=false

# Secure cookies: auto (secure when served over HTTPS), true, or false
COOKIE_SECURE=auto

# Log every request
LOG_REQUESTS=false
